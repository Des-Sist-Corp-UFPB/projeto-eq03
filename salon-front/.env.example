# Environment Variables - Frontend

# API URL (altere conforme seu ambiente)
VITE_API_URL=http://localhost:8080/v1

# Modo debug (remova em produção)
VITE_DEBUG=false

# Notificações push — mesma chave PÚBLICA VAPID configurada no backend (ver
# VAPID_PUBLIC_KEY na raiz do monorepo). Gere o par com:
#   cd salon-front && npx web-push generate-vapid-keys
# NUNCA regenere em produção depois de gerado (ver .env.example na raiz).
VITE_VAPID_PUBLIC_KEY=change-me-same-public-key-as-backend-VAPID_PUBLIC_KEY
